@page "/collection/{CollectionId:guid}/book/new"
@page "/book/{Id:guid}/edit"
@attribute [Authorize(Roles = "admin")]
@inject BookService BookService
@inject LabelService LabelService
@inject CollectionService CollectionService
@inject IsbnLookupService IsbnLookupService
@inject ImageUploadService ImageUploadService
@inject ImageViewerService ImageViewer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_isEdit ? "Modifier le livre" : "Nouveau livre")</PageTitle>

@if (_loading)
{
    <p>Chargement...</p>
}
else
{
    <div class="book-form-page">
    <div class="page-header">
        <a class="back-link" href="@BackHref">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            Retour
        </a>
        <h1>@(_isEdit ? "Modifier le livre" : "Nouveau livre") @(_collection != null ? $"— {_collection.Name}" : "")</h1>
        @if (_isEdit && _existingBook != null)
        {
            <p class="book-meta">
                Créé le @_existingBook.CreatedAt.ToString("dd/MM/yyyy à HH:mm")
                · Dernière modification le @_existingBook.UpdatedAt.ToString("dd/MM/yyyy à HH:mm")
            </p>
        }
    </div>

    <div class="book-form">

        <div class="form-card">
            <div class="form-card-title">Recherche par ISBN</div>
            <div class="isbn-lookup">
                <input placeholder="ISBN (optionnel)" @bind="_isbn" @bind:event="oninput"/>
                <button type="button" @onclick="LookupIsbnAsync" disabled="@(_isbnLookupBusy || string.IsNullOrWhiteSpace(_isbn) || !IsOnline)">
                    @(_isbnLookupBusy ? "Recherche..." : "Rechercher")
                </button>
                <button type="button" class="scan-toggle" @onclick="ToggleScanAsync" disabled="@_scanStarting">
                    @(_scanning ? "Fermer" : "Scanner")
                </button>
            </div>

            @if (_isbnLookupBusy)
            {
                <p class="form-info isbn-loading"><span class="spinner" aria-hidden="true"></span> Recherche des informations du livre…</p>
            }

            @if (_scanning)
            {
                <div class="barcode-scanner">
                    <video @ref="_scanVideo" muted autoplay playsinline></video>
                    <p class="form-info">Placez le code-barres ISBN dans le cadre.</p>
                </div>
            }
            @if (!string.IsNullOrEmpty(_scanError))
            {
                <p class="form-error">@_scanError</p>
            }
            @if (!string.IsNullOrEmpty(_isbnMessage))
            {
                <p class="form-info">@_isbnMessage</p>
            }
        </div>

        @* Outside the EditForm so pressing Enter adds a label instead of submitting. *@
        <div class="form-card">
            <div class="label-field">
                <span>Labels (optionnel)</span>
                <div class="label-editor">
                    @foreach (var label in _labels)
                    {
                        <span class="@LabelColor.ClassFor(label)">
                            @label
                            <button type="button" title="Retirer" @onclick="() => RemoveLabel(label)">&times;</button>
                        </span>
                    }
                    <input list="label-suggestions" autocomplete="off" placeholder="Ajouter un label"
                           @bind="_labelDraft" @bind:event="oninput" @onkeydown="OnLabelKeyDown"/>
                    <button type="button" @onclick="AddLabelDraft" disabled="@string.IsNullOrWhiteSpace(_labelDraft)">Ajouter</button>
                </div>
                <datalist id="label-suggestions">
                    @foreach (var label in _allLabels)
                    {
                        <option value="@label"/>
                    }
                </datalist>
            </div>
        </div>

        <EditForm Model="this" OnValidSubmit="SaveAsync">
            <div class="form-card">
                <div class="form-card-title">Détails</div>
                <label>
                    Titre
                    <input required @bind="_title" @bind:event="oninput"/>
                </label>
                <label>
                    Auteur
                    <input required list="author-suggestions" autocomplete="off" @bind="_author" @bind:event="oninput"/>
                </label>
                <datalist id="author-suggestions">
                    @foreach (var author in _authors)
                    {
                        <option value="@author"/>
                    }
                </datalist>
            </div>

            <div class="form-card">
                <div class="form-card-title">Couvertures</div>
                <div class="photo-inputs">
                    <div class="photo-input">
                        <span>Photo 1</span>
                        @if (!string.IsNullOrEmpty(_photo1Preview))
                        {
                            <img class="photo-preview zoomable" src="@_photo1Preview" alt="" @onclick="() => ImageViewer.Show(_photo1Preview)"/>
                        }
                        <div class="photo-actions">
                            <label class="file-btn">
                                <span>Fichier</span>
                                <input type="file" accept="image/*" @ref="_photo1FileRef" @onchange="() => OnPhotoSelectedAsync(1, _photo1FileRef)"/>
                            </label>
                            <label class="file-btn">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                                <span>Photo</span>
                                <input type="file" accept="image/*" capture="environment" @ref="_photo1CamRef" @onchange="() => OnPhotoSelectedAsync(1, _photo1CamRef)"/>
                            </label>
                            @if (!string.IsNullOrEmpty(_photo1Preview))
                            {
                                <button type="button" @onclick="() => CropAsync(1)">Recadrer</button>
                            }
                        </div>
                    </div>
                    <div class="photo-input">
                        <span>Photo 2</span>
                        @if (!string.IsNullOrEmpty(_photo2Preview))
                        {
                            <img class="photo-preview zoomable" src="@_photo2Preview" alt="" @onclick="() => ImageViewer.Show(_photo2Preview)"/>
                        }
                        <div class="photo-actions">
                            <label class="file-btn">
                                <span>Fichier</span>
                                <input type="file" accept="image/*" @ref="_photo2FileRef" @onchange="() => OnPhotoSelectedAsync(2, _photo2FileRef)"/>
                            </label>
                            <label class="file-btn">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                                <span>Photo</span>
                                <input type="file" accept="image/*" capture="environment" @ref="_photo2CamRef" @onchange="() => OnPhotoSelectedAsync(2, _photo2CamRef)"/>
                            </label>
                            @if (!string.IsNullOrEmpty(_photo2Preview))
                            {
                                <button type="button" @onclick="() => CropAsync(2)">Recadrer</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_cropMessage))
            {
                <p class="form-info">@_cropMessage</p>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            @if (!IsOnline)
            {
                <p class="form-error">L'ajout et la modification de livres sont indisponibles hors ligne.</p>
            }

            <button type="submit" class="primary" disabled="@(_saving || !IsOnline)">@(_saving ? "Enregistrement..." : "Enregistrer")</button>
        </EditForm>
    </div>
    </div>
}
