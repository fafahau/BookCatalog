@page "/labels"
@attribute [Authorize(Roles = "admin")]
@inject LabelService LabelService
@inject ConfirmService Confirm

<PageTitle>Labels</PageTitle>

<h1>Labels</h1>

@if (_loading)
{
    <p>Chargement...</p>
}
else
{
    <div class="new-label">
        <input placeholder="Nom du nouveau label" @bind="_newLabelName" @bind:event="oninput"
               @onkeydown="OnNewLabelKeyDown"/>
        <button class="primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_newLabelName))"
                @onclick="CreateAsync">Ajouter</button>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="form-info">@_message</p>
    }

    @if (_labels.Count == 0)
    {
        <p class="empty-state">Aucun label pour l'instant.</p>
    }
    else
    {
        <ul class="label-list">
            @foreach (var label in _labels)
            {
                <li class="label-row" @key="label.Id">
                    <input value="@_drafts[label.Id]" @oninput="e => _drafts[label.Id] = (string?)e.Value ?? string.Empty"/>
                    <button class="primary"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_drafts[label.Id]) || _drafts[label.Id].Trim() == label.Name)"
                            @onclick="() => RenameAsync(label)">Renommer</button>
                    <button class="icon-button danger" title="Supprimer" disabled="@_busy" @onclick="() => DeleteAsync(label)">🗑</button>
                </li>
            }
        </ul>
        <p class="hint">Renommer ou supprimer un label s'applique à tous les livres qui le portent.</p>
    }
}
