@page "/"
@attribute [Authorize]

<PageTitle>Accueil</PageTitle>
<div class="home-tiles">
    <a class="home-tile" href="recherche">
        <span class="home-tile-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="M21 21l-4.3-4.3"/>
            </svg>
        </span>
        <span class="home-tile-label">Recherche</span>
    </a>
    <a class="home-tile" href="collections">
        <span class="home-tile-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
        </span>
        <span class="home-tile-label">Collections</span>
    </a>
    <AuthorizeView Roles="admin">
        <Authorized>
            <a class="home-tile" href="users">
                <span class="home-tile-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
                <span class="home-tile-label">Utilisateurs</span>
            </a>
            <a class="home-tile" href="labels">
                <span class="home-tile-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20.59 13.41L11 3.83V3H3v8h.83l9.58 9.59a2 2 0 0 0 2.83 0l4.35-4.35a2 2 0 0 0 0-2.83z"/>
                        <circle cx="6.5" cy="6.5" r="1"/>
                    </svg>
                </span>
                <span class="home-tile-label">Labels</span>
            </a>
        </Authorized>
    </AuthorizeView>
</div>
