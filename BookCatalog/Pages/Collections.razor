@page "/collections"
@attribute [Authorize]
@inject CollectionService CollectionService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ConfirmService Confirm

<PageTitle>Collections</PageTitle>

<h1>Collections</h1>

@if (_loading)
{
    <p>Chargement...</p>
}
else
{
    <AuthorizeView Roles="admin" Context="adminContext">
        <Authorized>
            <div class="new-collection">
                <input @bind="_newCollectionName" @bind:event="oninput" placeholder="Nom de la nouvelle collection"/>
                <button class="primary" @onclick="CreateAsync" disabled="@string.IsNullOrWhiteSpace(_newCollectionName)">Ajouter</button>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (!_collections.Any())
    {
        <p class="empty-state">Aucune collection pour l'instant.</p>
    }
    else
    {
        <ul class="collection-list">
            @foreach (var collection in _collections)
            {
                <li class="collection-row">
                    @if (_editingId == collection.Id)
                    {
                        <input @bind="_editingName" @bind:event="oninput"/>
                        <button class="icon-button" title="Enregistrer" @onclick="() => SaveRenameAsync(collection.Id)">✔</button>
                        <button class="icon-button" title="Annuler" @onclick="CancelRename">✕</button>
                    }
                    else
                    {
                        <a class="collection-name" href="@($"collection/{collection.Id}")">@collection.Name</a>
                        <span class="collection-count" title="Nombre de livres">@GetBookCount(collection.Id)</span>
                        <span class="collection-percent" title="Part du total des livres">@GetBookPercent(collection.Id).ToString("0.#")&nbsp;%</span>
                        <AuthorizeView Roles="admin" Context="rowAdminContext">
                            <Authorized>
                                <button class="icon-button" title="Renommer" @onclick="() => StartRename(collection)">✎</button>
                                <button class="icon-button danger" title="Supprimer" @onclick="() => DeleteAsync(collection)">🗑</button>
                            </Authorized>
                        </AuthorizeView>
                    }
                </li>
            }
        </ul>
    }
}
