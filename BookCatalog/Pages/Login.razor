@page "/login"
@layout LoginLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<div class="auth-card">
    <h1 class="auth-title">
        <img src="icon-192.png" alt="" width="40" height="40" />
        <span>Déjà Dans la Bibli</span>
    </h1>

    @if (_mode == Mode.Login)
    {
        <h2>Connexion</h2>
        <EditForm Model="_model" OnValidSubmit="LoginAsync">
            <DataAnnotationsValidator/>
            <label>
                Email
                <div class="input-icon">
                    <FieldIcon Kind="mail"/>
                    <InputText @bind-Value="_model.Email" type="email" autocomplete="username"/>
                </div>
            </label>
            <label>
                Mot de passe
                <div class="password-field">
                    <FieldIcon Kind="lock"/>
                    <InputText @bind-Value="_model.Password" type="@PasswordInputType" autocomplete="current-password"/>
                    <PasswordToggle Visible="_showPassword" OnToggle="ToggleShowPassword"/>
                </div>
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            <button type="submit" class="primary" disabled="@_busy">Se connecter</button>
        </EditForm>
        <p class="switch-mode">
            <button class="link-button" @onclick="() => SwitchMode(Mode.ForgotPassword)">Mot de passe oublié ?</button>
        </p>
        <p class="switch-mode">
            Pas encore de compte ?
            <button class="link-button" @onclick="() => SwitchMode(Mode.Register)">Créer un compte</button>
        </p>
    }
    else if (_mode == Mode.ForgotPassword)
    {
        <h2>Mot de passe oublié</h2>
        <EditForm Model="_model" OnValidSubmit="SendResetAsync">
            <label>
                Email
                <div class="input-icon">
                    <FieldIcon Kind="mail"/>
                    <InputText @bind-Value="_model.Email" type="email" autocomplete="username"/>
                </div>
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }
            @if (!string.IsNullOrEmpty(_info))
            {
                <p class="form-info">@_info</p>
            }

            <button type="submit" class="primary" disabled="@_busy">Envoyer le lien de réinitialisation</button>
        </EditForm>
        <p class="switch-mode">
            <button class="link-button" @onclick="() => SwitchMode(Mode.Login)">Retour à la connexion</button>
        </p>
    }
    else
    {
        <h2>Créer un compte</h2>
        <EditForm Model="_model" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator/>
            <label>
                Nom affiché
                <div class="input-icon">
                    <FieldIcon Kind="user"/>
                    <InputText @bind-Value="_model.DisplayName" autocomplete="name"/>
                </div>
            </label>
            <label>
                Email
                <div class="input-icon">
                    <FieldIcon Kind="mail"/>
                    <InputText @bind-Value="_model.Email" type="email" autocomplete="username"/>
                </div>
            </label>
            <label>
                Mot de passe (6 caractères min.)
                <div class="password-field">
                    <FieldIcon Kind="lock"/>
                    <InputText @bind-Value="_model.Password" type="@PasswordInputType" autocomplete="new-password"/>
                    <PasswordToggle Visible="_showPassword" OnToggle="ToggleShowPassword"/>
                </div>
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }
            @if (!string.IsNullOrEmpty(_info))
            {
                <p class="form-info">@_info</p>
            }

            <button type="submit" class="primary" disabled="@_busy">Créer le compte</button>
        </EditForm>
        <p class="switch-mode">
            Déjà un compte ?
            <button class="link-button" @onclick="() => SwitchMode(Mode.Login)">Se connecter</button>
        </p>
        <p class="hint">Un nouveau compte est en lecture seule par défaut ; un administrateur doit ensuite vous accorder les droits d'édition.</p>
    }
</div>
