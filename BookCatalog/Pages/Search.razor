@page "/recherche"
@attribute [Authorize]
@inject BookService BookService
@inject CollectionService CollectionService
@inject LabelService LabelService
@inject ImageViewerService ImageViewer
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Recherche</PageTitle>

<h1>Recherche</h1>

<div class="search-modes">
    <button class="@(_mode == SearchMode.Isbn ? "active" : "")" @onclick="() => SetMode(SearchMode.Isbn)">ISBN</button>
    <button class="@(_mode == SearchMode.Title ? "active" : "")" @onclick="() => SetMode(SearchMode.Title)">Titre</button>
    <button class="@(_mode == SearchMode.Author ? "active" : "")" @onclick="() => SetMode(SearchMode.Author)">Auteur</button>
    <button class="@(_mode == SearchMode.Label ? "active" : "")" @onclick="() => SetMode(SearchMode.Label)">Label</button>
</div>

<div class="isbn-search">
    <input placeholder="@Placeholder" list="@(_mode == SearchMode.Label ? "search-label-suggestions" : null)"
           @bind="_query" @bind:event="oninput" @onkeyup="OnKeyUp"/>
    <datalist id="search-label-suggestions">
        @foreach (var label in _allLabels)
        {
            <option value="@label"/>
        }
    </datalist>
    <button class="primary" @onclick="SearchAsync" disabled="@(_searching || string.IsNullOrWhiteSpace(_query))">
        @(_searching ? "Recherche..." : "Rechercher")
    </button>
    @if (_mode == SearchMode.Isbn)
    {
        <button type="button" class="scan-toggle" @onclick="ToggleScanAsync" disabled="@_scanStarting">
            @(_scanning ? "Fermer" : "Scanner")
        </button>
    }
</div>

@if (_scanning)
{
    <div class="barcode-scanner">
        <video @ref="_scanVideo" muted autoplay playsinline></video>
        <p class="form-info">Placez le code-barres ISBN dans le cadre.</p>
    </div>
}
@if (!string.IsNullOrEmpty(_scanError))
{
    <p class="form-error">@_scanError</p>
}

@if (_searched)
{
    @if (_results.Any())
    {
        <ul class="isbn-results">
            @foreach (var hit in _results)
            {
                <li class="isbn-result">
                    <a href="@($"collection/{hit.Book.CollectionId}")">
                        @if (hit.Book.PhotoUrl1 is { } cover)
                        {
                            <img class="book-thumb zoomable" src="@cover" alt=""
                                 onerror="this.onerror=null;this.src='images/istockphoto-1125976691-170667a.jpg';this.classList.add('no-cover');"
                                 @onclick="() => ImageViewer.Show(cover)"
                                 @onclick:preventDefault="true" @onclick:stopPropagation="true"/>
                        }
                        else
                        {
                            <img class="book-thumb no-cover" src="images/istockphoto-1125976691-170667a.jpg" alt=""/>
                        }
                        <span class="isbn-result-text">
                            <span class="isbn-result-title">@hit.Book.Title</span>
                            <span class="isbn-result-author">@hit.Book.Author</span>
                            <span class="isbn-result-collection">@hit.CollectionName</span>
                            @if (hit.Book.LabelNames is { Count: > 0 })
                            {
                                <span class="book-labels">
                                    @foreach (var label in hit.Book.LabelNames)
                                    {
                                        <span class="label-chip">@label</span>
                                    }
                                </span>
                            }
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
    else if (_mode == SearchMode.Isbn)
    {
        <p class="empty-state">Pas de livre avec cet ISBN trouvé</p>

        @if (_booksWithoutIsbn.Any())
        {
            <h2 class="no-isbn-heading">Livres sans ISBN</h2>
            <ul class="isbn-results">
                @foreach (var hit in _booksWithoutIsbn)
                {
                    <li class="isbn-result">
                        <a href="@($"collection/{hit.Book.CollectionId}")">
                            @if (hit.Book.PhotoUrl1 is { } cover)
                            {
                                <img class="book-thumb zoomable" src="@cover" alt=""
                                     onerror="this.onerror=null;this.src='images/istockphoto-1125976691-170667a.jpg';this.classList.add('no-cover');"
                                     @onclick="() => ImageViewer.Show(cover)"
                                     @onclick:preventDefault="true" @onclick:stopPropagation="true"/>
                            }
                            else
                            {
                                <img class="book-thumb no-cover" src="images/istockphoto-1125976691-170667a.jpg" alt=""/>
                            }
                            <span class="isbn-result-text">
                                <span class="isbn-result-title">@hit.Book.Title</span>
                                <span class="isbn-result-author">@hit.Book.Author</span>
                                <span class="isbn-result-collection">@hit.CollectionName</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    }
    else
    {
        <p class="empty-state">Aucun livre ne correspond.</p>
    }
}
