@page "/collection/{Id:guid}"
@attribute [Authorize]
@inject CollectionService CollectionService
@inject BookService BookService
@inject LabelService LabelService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ConfirmService Confirm
@inject UiStateStore UiState

<PageTitle>@(_collection?.Name ?? "Collection")</PageTitle>

@if (_loading)
{
    <p>Chargement...</p>
}
else if (_collection == null)
{
    <p>Collection introuvable.</p>
}
else
{
    <div class="page-header">
        <a class="back-link" href="">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            Collections
        </a>
        <h1>@_collection.Name</h1>
    </div>

    <details class="filters-accordion" open="@_filtersOpen">
        <summary>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-2px; margin-right:0.35rem;"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
            Filtres
        </summary>
        <div class="filters">
            <input placeholder="Filtrer par titre" @bind="_filter.Title" @bind:event="oninput" @onkeyup="ReloadBooksAsync"/>
            <input placeholder="Filtrer par auteur" @bind="_filter.Author" @bind:event="oninput" @onkeyup="ReloadBooksAsync"/>
            <input placeholder="Filtrer par label" list="collection-label-suggestions" @bind="_filter.Label" @bind:event="oninput" @onkeyup="ReloadBooksAsync"/>
            <datalist id="collection-label-suggestions">
                @foreach (var label in _allLabels)
                {
                    <option value="@label"/>
                }
            </datalist>
            <label class="sort-select">
                Trier par
                <select @bind="_filter.Sort" @bind:after="ReloadBooksAsync">
                    <option value="@BookSort.Recent">Plus récent</option>
                    <option value="@BookSort.TitleAsc">Titre (A → Z)</option>
                    <option value="@BookSort.TitleDesc">Titre (Z → A)</option>
                </select>
            </label>
            <button type="button" class="clear-filters" @onclick="ClearFiltersAsync" disabled="@(!HasActiveFilters)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Effacer les filtres
            </button>
        </div>

        <div class="isbn-lookup-panel">
            <IsbnScanSearch Searching="_isbnSearching" OnSearch="IsbnSearchAsync"
                            Placeholder="Cet ISBN est-il déjà dans la collection ?"/>

            @if (_isbnSearched)
            {
                @if (_isbnHere.Any())
                {
                    <p class="isbn-verdict found">✓ Déjà dans cette collection</p>
                    <ul class="book-list">
                        @foreach (var book in _isbnHere)
                        {
                            <li class="book-row">
                                <BookListItem Book="book" OnClick="() => OpenBook(book)"/>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="isbn-verdict missing">✗ Pas dans cette collection</p>
                    @if (_isbnElsewhere.Any())
                    {
                        <p class="isbn-elsewhere">Présent dans : @string.Join(", ", _isbnElsewhere)</p>
                    }
                }
            }
        </div>
    </details>

    <AuthorizeView Roles="admin" Context="calendarContext">
        <Authorized>
            <details class="filters-accordion calendar-accordion">
                <summary>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-2px; margin-right:0.35rem;"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Calendrier des ajouts
                </summary>
                <CollectionCalendar CollectionId="Id"/>
            </details>
        </Authorized>
    </AuthorizeView>

    <div class="toolbar">
        <div class="toolbar-toggles">
            <div class="view-toggle">
                <button class="@(_viewMode == ViewMode.List ? "active" : "")" @onclick='() => SetViewMode(ViewMode.List)'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
                    Liste
                </button>
                <button class="@(_viewMode == ViewMode.Tile ? "active" : "")" @onclick='() => SetViewMode(ViewMode.Tile)'>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                    Tuiles
                </button>
            </div>

            <div class="group-toggle">
                <button class="@(_groupMode == GroupMode.None ? "active" : "")" @onclick="() => SetGroupMode(GroupMode.None)">Aucun</button>
                <button class="@(_groupMode == GroupMode.Label ? "active" : "")" @onclick="() => SetGroupMode(GroupMode.Label)">Par label</button>
                <button class="@(_groupMode == GroupMode.Author ? "active" : "")" @onclick="() => SetGroupMode(GroupMode.Author)">Par auteur</button>
            </div>

            @if (_groupMode != GroupMode.None)
            {
                <div class="group-toggle expand-toggle">
                    <button class="@(_groupsExpanded ? "active" : "")" @onclick="() => SetGroupsExpanded(true)">Tout déployer</button>
                    <button class="@(!_groupsExpanded ? "active" : "")" @onclick="() => SetGroupsExpanded(false)">Tout réduire</button>
                </div>
            }

            <div class="page-toggle">
                <label class="page-size-select">
                    Livres par page
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                        <option value="20">20</option>
                        <option value="40">40</option>
                        <option value="60">60</option>
                    </select>
                </label>
            </div>
        </div>

        <AuthorizeView Roles="admin" Context="adminContext">
            <Authorized>
                <div class="toolbar-admin-actions">
                    <button type="button" class="select-toggle @(_selecting ? "active" : "")" @onclick="ToggleSelecting" disabled="@(!IsOnline)">
                        @(_selecting ? "Annuler la sélection" : "Sélectionner")
                    </button>
                    <button class="primary add-book" @onclick="AddBook" disabled="@(!IsOnline)" title="@(IsOnline ? null : "Indisponible hors ligne")">+ Ajouter un livre</button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (_selecting)
    {
        <div class="selection-bar">
            <span class="selection-count">@_selectedIds.Count sélectionné(s)</span>
            <button type="button" @onclick="SelectAllFiltered">Tout sélectionner</button>
            <button type="button" @onclick="ClearSelection" disabled="@(_selectedIds.Count == 0)">Tout désélectionner</button>
            <button type="button" class="primary" @onclick="OpenLabelDialog" disabled="@(!IsOnline || _selectedIds.Count == 0)">
                Ajouter des labels…
            </button>
        </div>
    }

    @if (_booksLoading)
    {
        <p>Chargement des livres...</p>
    }
    else if (!_books.Any())
    {
        <p class="empty-state">Aucun livre ne correspond.</p>
    }
    else if (_groupMode == GroupMode.None)
    {
        <BookCollectionList Books="PagedBooks" TileView="_viewMode == ViewMode.Tile"
                           OnOpen="OpenBook" OnDelete="DeleteBookAsync"
                           SelectionMode="_selecting" SelectedIds="_selectedIds" OnToggleSelect="ToggleBook"/>

        @if (_totalPages > 1)
        {
            <div class="pager">
                <button class="icon-button" @onclick="PrevPage" disabled="@(_currentPage <= 1)">‹ Précédent</button>
                <span class="pager-status">Page @_currentPage / @_totalPages — @_books.Count livres</span>
                <button class="icon-button" @onclick="NextPage" disabled="@(_currentPage >= _totalPages)">Suivant ›</button>
            </div>
        }
    }
    else
    {
        @foreach (var group in _groupedBooks)
        {
            <details class="book-group" open="@_groupsExpanded">
                <summary class="book-group-header">
                    <span class="book-group-name">@group.Name</span>
                    <span class="book-group-count">@group.Books.Count</span>
                </summary>
                <BookCollectionList Books="group.Books" TileView="_viewMode == ViewMode.Tile"
                                   OnOpen="OpenBook" OnDelete="DeleteBookAsync"
                                   SelectionMode="_selecting" SelectedIds="_selectedIds" OnToggleSelect="ToggleBook"/>
            </details>
        }
    }

    @if (_labelDialogOpen)
    {
        <div class="modal-overlay" @onclick="CloseLabelDialog">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="bulk-label-title"
                 @onclick:stopPropagation="true">
                <h2 id="bulk-label-title" class="modal-title">
                    Ajouter des labels à @_selectedIds.Count livre(s)
                </h2>
                <div class="label-editor">
                    @foreach (var label in _dialogLabels)
                    {
                        <span class="label-chip">
                            @label
                            <button type="button" title="Retirer" @onclick="() => RemoveDialogLabel(label)">&times;</button>
                        </span>
                    }
                    <input list="collection-label-suggestions" autocomplete="off" placeholder="Ajouter un label"
                           @bind="_dialogLabelDraft" @bind:event="oninput" @onkeydown="OnDialogLabelKeyDown"/>
                    <button type="button" @onclick="AddDialogLabel" disabled="@string.IsNullOrWhiteSpace(_dialogLabelDraft)">Ajouter</button>
                </div>
                <div class="modal-actions">
                    <button type="button" @onclick="CloseLabelDialog">Annuler</button>
                    <button type="button" class="primary" @onclick="ApplyLabelsAsync"
                            disabled="@(!IsOnline || _applyingLabels || (_dialogLabels.Count == 0 && string.IsNullOrWhiteSpace(_dialogLabelDraft)))">
                        @(_applyingLabels ? "Application…" : "Ajouter")
                    </button>
                </div>
            </div>
        </div>
    }
}
