@page "/collection/{Id:guid}"
@attribute [Authorize]
@inject CollectionService CollectionService
@inject BookService BookService
@inject LabelService LabelService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject ConfirmService Confirm

<PageTitle>@(_collection?.Name ?? "Collection")</PageTitle>

@if (_loading)
{
    <p>Chargement...</p>
}
else if (_collection == null)
{
    <p>Collection introuvable.</p>
}
else
{
    <div class="page-header">
        <a class="back-link" href="">&larr; Collections</a>
        <h1>@_collection.Name</h1>
    </div>

    <details class="filters-accordion">
        <summary>Filtres</summary>
        <div class="filters">
            <input placeholder="Filtrer par titre" @bind="_filter.Title" @bind:event="oninput" @onkeyup="ReloadBooksAsync"/>
            <input placeholder="Filtrer par auteur" @bind="_filter.Author" @bind:event="oninput" @onkeyup="ReloadBooksAsync"/>
            <input placeholder="Filtrer par label" list="collection-label-suggestions" @bind="_filter.Label" @bind:event="oninput" @onkeyup="ReloadBooksAsync"/>
            <datalist id="collection-label-suggestions">
                @foreach (var label in _allLabels)
                {
                    <option value="@label"/>
                }
            </datalist>
            <label class="sort-select">
                Trier par
                <select @bind="_filter.Sort" @bind:after="ReloadBooksAsync">
                    <option value="@BookSort.Recent">Plus récent</option>
                    <option value="@BookSort.TitleAsc">Titre (A → Z)</option>
                    <option value="@BookSort.TitleDesc">Titre (Z → A)</option>
                </select>
            </label>
        </div>

        <div class="isbn-lookup-panel">
            <IsbnScanSearch Searching="_isbnSearching" OnSearch="IsbnSearchAsync"
                            Placeholder="Cet ISBN est-il déjà dans la collection ?"/>

            @if (_isbnSearched)
            {
                @if (_isbnHere.Any())
                {
                    <p class="isbn-verdict found">✓ Déjà dans cette collection</p>
                    <ul class="book-list">
                        @foreach (var book in _isbnHere)
                        {
                            <li class="book-row">
                                <BookListItem Book="book" OnClick="() => OpenBook(book)"/>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="isbn-verdict missing">✗ Pas dans cette collection</p>
                    @if (_isbnElsewhere.Any())
                    {
                        <p class="isbn-elsewhere">Présent dans : @string.Join(", ", _isbnElsewhere)</p>
                    }
                }
            }
        </div>
    </details>

    <div class="toolbar">
        <div class="toolbar-toggles">
            <div class="view-toggle">
                <button class="@(_viewMode == ViewMode.List ? "active" : "")" @onclick='() => SetViewMode(ViewMode.List)'>☰ Liste</button>
                <button class="@(_viewMode == ViewMode.Tile ? "active" : "")" @onclick='() => SetViewMode(ViewMode.Tile)'>▦ Tuiles</button>
            </div>

            <div class="group-toggle">
                <button class="@(_groupMode == GroupMode.None ? "active" : "")" @onclick="() => SetGroupMode(GroupMode.None)">Aucun</button>
                <button class="@(_groupMode == GroupMode.Label ? "active" : "")" @onclick="() => SetGroupMode(GroupMode.Label)">Par label</button>
                <button class="@(_groupMode == GroupMode.Author ? "active" : "")" @onclick="() => SetGroupMode(GroupMode.Author)">Par auteur</button>
            </div>

            <div class="page-toggle">
                <label class="page-size-select">
                    Livres par page
                    <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
                        <option value="20">20</option>
                        <option value="40">40</option>
                        <option value="60">60</option>
                    </select>
                </label>
            </div>
        </div>

        <AuthorizeView Roles="admin" Context="adminContext">
            <Authorized>
                <button class="primary add-book" @onclick="AddBook">+ Ajouter un livre</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (_booksLoading)
    {
        <p>Chargement des livres...</p>
    }
    else if (!_books.Any())
    {
        <p class="empty-state">Aucun livre ne correspond.</p>
    }
    else if (_groupMode == GroupMode.None)
    {
        @RenderBooks(PagedBooks)

        @if (_totalPages > 1)
        {
            <div class="pager">
                <button class="icon-button" @onclick="PrevPage" disabled="@(_currentPage <= 1)">‹ Précédent</button>
                <span class="pager-status">Page @_currentPage / @_totalPages — @_books.Count livres</span>
                <button class="icon-button" @onclick="NextPage" disabled="@(_currentPage >= _totalPages)">Suivant ›</button>
            </div>
        }
    }
    else
    {
        @foreach (var group in _groupedBooks)
        {
            <details class="book-group" open>
                <summary class="book-group-header">
                    <span class="book-group-name">@group.Name</span>
                    <span class="book-group-count">@group.Books.Count</span>
                </summary>
                @RenderBooks(group.Books)
            </details>
        }
    }
}

@code {
    private RenderFragment RenderBooks(IReadOnlyList<Book> books) =>@<text>
        @if (_viewMode == ViewMode.List)
        {
            <ul class="book-list">
                @foreach (var book in books)
                {
                    <li class="book-row">
                        <BookListItem Book="book" OnClick="@(() => OpenBook(book))"/>
                        <AuthorizeView Roles="admin" Context="rowAdminContext">
                            <Authorized>
                                <button class="icon-button danger" title="Supprimer" @onclick="@(() => DeleteBookAsync(book))">🗑</button>
                            </Authorized>
                        </AuthorizeView>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="book-tile-grid">
                @foreach (var book in books)
                {
                    <div class="book-tile-wrapper">
                        <BookTile Book="book" OnClick="@(() => OpenBook(book))"/>
                        <AuthorizeView Roles="admin" Context="tileAdminContext">
                            <Authorized>
                                <button class="icon-button danger tile-delete" title="Supprimer" @onclick="@(() => DeleteBookAsync(book))">🗑</button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                }
            </div>
        }
    </text>;
}

@code {
    private enum ViewMode { List, Tile }
    private enum GroupMode { None, Label, Author }

    [Parameter]
    public Guid Id { get; set; }

    private BookCollection? _collection;
    private List<Book> _books = new();
    private bool _loading = true;
    private bool _booksLoading = true;
    private ViewMode _viewMode = ViewMode.List;
    private GroupMode _groupMode = GroupMode.None;

    private int _pageSize = 20;
    private int _currentPage = 1;

    private int _totalPages =>
        _books.Count > 0
            ? (int)Math.Ceiling(_books.Count / (double)_pageSize)
            : 1;

    private IReadOnlyList<Book> PagedBooks =>
        _books.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
    private readonly BookFilter _filter = new();
    private List<string> _allLabels = new();

    private const string NoLabel = "Sans label";
    private const string NoAuthor = "Sans auteur";

    private sealed record BookGroup(string Name, List<Book> Books);
    private List<BookGroup> _groupedBooks = new();

    private bool _isbnSearching;
    private bool _isbnSearched;
    private List<Book> _isbnHere = new();
    private List<string> _isbnElsewhere = new();

    protected override async Task OnInitializedAsync()
    {
        _collection = await CollectionService.GetByIdAsync(Id);
        _loading = false;

        try
        {
            _allLabels = await LabelService.GetNamesAsync();
        }
        catch
        {
            _allLabels = new();
        }

        await ReloadBooksAsync();
    }

    private void SetViewMode(ViewMode mode) => _viewMode = mode;

    private void OnPageSizeChanged() => _currentPage = 1;

    private void PrevPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void NextPage()
    {
        if (_currentPage < _totalPages)
        {
            _currentPage++;
        }
    }

    private void SetGroupMode(GroupMode mode)
    {
        _groupMode = mode;
        RebuildGroups();
    }

    private async Task ReloadBooksAsync()
    {
        _booksLoading = true;
        _books = await BookService.GetByCollectionAsync(Id, _filter);
        _booksLoading = false;
        _currentPage = Math.Clamp(_currentPage, 1, _totalPages);
        RebuildGroups();
        StateHasChanged();
    }

    /// <summary>
    /// Buckets <see cref="_books"/> by label or author. A book with several labels
    /// lands in each of its groups; books missing the key go in a "Sans …" group
    /// that sorts last. Books keep the order set by the current sort.
    /// </summary>
    private void RebuildGroups()
    {
        if (_groupMode == GroupMode.None)
        {
            _groupedBooks = new();
            return;
        }

        var placeholder = _groupMode == GroupMode.Label ? NoLabel : NoAuthor;
        var groups = new Dictionary<string, List<Book>>(StringComparer.CurrentCultureIgnoreCase);

        foreach (var book in _books)
        {
            IEnumerable<string> keys = _groupMode switch
            {
                GroupMode.Label => book.LabelNames is { Count: > 0 }
                    ? book.LabelNames
                    : new List<string> { placeholder },
                _ => new List<string> { string.IsNullOrWhiteSpace(book.Author) ? placeholder : book.Author.Trim() }
            };

            foreach (var key in keys)
            {
                if (!groups.TryGetValue(key, out var bucket))
                {
                    bucket = new();
                    groups[key] = bucket;
                }
                bucket.Add(book);
            }
        }

        _groupedBooks = groups
            .OrderBy(g => g.Key == placeholder ? 1 : 0)
            .ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase)
            .Select(g => new BookGroup(g.Key, g.Value))
            .ToList();
    }

    private async Task IsbnSearchAsync(string isbn)
    {
        _isbnSearching = true;
        _isbnSearched = false;
        StateHasChanged();
        try
        {
            var matches = await BookService.SearchByIsbnAsync(isbn);
            _isbnHere = matches.Where(b => b.CollectionId == Id).ToList();

            var otherIds = matches
                .Where(b => b.CollectionId != Id)
                .Select(b => b.CollectionId)
                .Distinct()
                .ToList();

            if (otherIds.Any())
            {
                var all = await CollectionService.GetAllAsync();
                _isbnElsewhere = all
                    .Where(c => otherIds.Contains(c.Id))
                    .Select(c => c.Name)
                    .OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase)
                    .ToList();
            }
            else
            {
                _isbnElsewhere = new();
            }

            _isbnSearched = true;
        }
        finally
        {
            _isbnSearching = false;
            StateHasChanged();
        }
    }

    private void AddBook() => Navigation.NavigateTo($"collection/{Id}/book/new");

    private void OpenBook(Book book)
    {
        if (AuthService.IsAdmin)
        {
            Navigation.NavigateTo($"book/{book.Id}/edit");
        }
    }

    private async Task DeleteBookAsync(Book book)
    {
        var confirmed = await Confirm.ConfirmAsync(
            $"Supprimer le livre « {book.Title} » ?",
            title: "Supprimer le livre");
        if (!confirmed)
        {
            return;
        }

        await BookService.DeleteAsync(book);
        await ReloadBooksAsync();
    }
}
