@page "/reset-password"
@layout LoginLayout
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Nouveau mot de passe</PageTitle>

<div class="auth-card">
    <h1 class="auth-title">
        <img src="icon-192.png" alt="" width="40" height="40" />
        <span>Déjà Dans la Bibli</span>
    </h1>

    @if (_state == State.Checking)
    {
        <h2>Réinitialisation</h2>
        <p>Vérification du lien…</p>
    }
    else if (_state == State.Invalid)
    {
        <h2>Lien invalide</h2>
        <p class="form-error">@_error</p>
        <p class="switch-mode">
            <button class="link-button" @onclick="GoToLogin">Demander un nouveau lien</button>
        </p>
    }
    else if (_state == State.Done)
    {
        <h2>Mot de passe modifié</h2>
        <p class="form-info">Votre mot de passe a été mis à jour. Vous pouvez maintenant vous connecter.</p>
        <p class="switch-mode">
            <button class="link-button" @onclick="GoToLogin">Se connecter</button>
        </p>
    }
    else
    {
        <h2>Choisir un nouveau mot de passe</h2>
        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator/>
            <label>
                Nouveau mot de passe (6 caractères min.)
                <div class="password-field">
                    <InputText @bind-Value="_model.Password" type="@PasswordInputType" autocomplete="new-password"/>
                    <PasswordToggle Visible="_showPassword" OnToggle="ToggleShowPassword"/>
                </div>
            </label>
            <label>
                Confirmer le mot de passe
                <div class="password-field">
                    <InputText @bind-Value="_model.Confirm" type="@PasswordInputType" autocomplete="new-password"/>
                    <PasswordToggle Visible="_showPassword" OnToggle="ToggleShowPassword"/>
                </div>
            </label>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="form-error">@_error</p>
            }

            <button type="submit" class="primary" disabled="@_busy">Enregistrer</button>
        </EditForm>
    }
</div>
