@inject AuthService AuthService
@inject NavigationManager Navigation
@inject OfflineLibraryService Offline

<AuthorizeView>
    <Authorized>
        <header class="topbar">
            <a class="brand" href="">
                <img class="brand-logo" src="icon-192.png" alt="" width="32" height="32" />
                <span>Déjà Dans la Bibli</span>
            </a>
            <ThemeToggle />
        </header>
        <nav class="navmenu">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Accueil</NavLink>
            <NavLink class="nav-link" href="recherche">Recherche</NavLink>
            <NavLink class="nav-link" href="collections">Collections</NavLink>
            <AuthorizeView Roles="admin" Context="adminContext">
                <Authorized>
                    @if (Offline.IsOnline)
                    {
                        <NavLink class="nav-link" href="labels">Labels</NavLink>
                        <NavLink class="nav-link" href="users">Utilisateurs</NavLink>
                    }
                    else
                    {
                        <span class="nav-link nav-link--disabled" title="Indisponible hors ligne">Labels</span>
                        <span class="nav-link nav-link--disabled" title="Indisponible hors ligne">Utilisateurs</span>
                    }
                </Authorized>
            </AuthorizeView>
            <button class="nav-link logout" @onclick="LogoutAsync">Déconnexion</button>
        </nav>
    </Authorized>
</AuthorizeView>
