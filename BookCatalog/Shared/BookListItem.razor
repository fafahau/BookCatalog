@inject ImageViewerService ImageViewer

<div class="book-list-item" @onclick="OnClick">
    @if (Book.PhotoUrl1 is { } cover)
    {
        <img class="book-thumb zoomable" src="@cover" alt=""
             @onclick="() => ImageViewer.Show(cover)" @onclick:stopPropagation="true"/>
    }
    else
    {
        <img class="book-thumb no-cover" src="images/istockphoto-1125976691-170667a.jpg" alt=""/>
    }
    <div class="book-info">
        <div class="book-title">@Book.Title</div>
        <div class="book-author">@Book.Author</div>
        @if (Book.LabelNames is { Count: > 0 })
        {
            <div class="book-labels">
                @foreach (var label in Book.LabelNames)
                {
                    <span class="label-chip">@label</span>
                }
            </div>
        }
    </div>
</div>
