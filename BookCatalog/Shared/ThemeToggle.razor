@inject IJSInProcessRuntime Js

<div class="theme-toggle @Class" role="group" aria-label="Thème">
    <button type="button" class="@ButtonClass("auto")" title="Suivre l'appareil"
            aria-pressed="@( _choice == "auto" )" @onclick='() => SetChoice("auto")'>🖥️</button>
    <button type="button" class="@ButtonClass("light")" title="Thème clair"
            aria-pressed="@( _choice == "light" )" @onclick='() => SetChoice("light")'>☀️</button>
    <button type="button" class="@ButtonClass("dark")" title="Thème sombre"
            aria-pressed="@( _choice == "dark" )" @onclick='() => SetChoice("dark")'>🌙</button>
</div>
